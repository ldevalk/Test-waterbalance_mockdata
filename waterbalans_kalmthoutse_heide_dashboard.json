    {
      "id": 3,
      "type": "barchart",
      "title": "Totaal per post in de gekozen periode",
      "description": "Som van de dagwaarden: in m³ (bij m³/dag) of in mm (bij mm/dag). Netto = bergingsverandering van de selectie.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
