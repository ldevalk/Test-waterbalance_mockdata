      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${ds}"
          },
          "type": "json",
          "source": "url",
          "url": "${data_url}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "parser": "backend",
          "root_selector": "(\n  $keuze := [${gebied:doublequote}];\n  $sel := gebieden[(id in $keuze) or (land in $keuze) or (\"Hele Grenspark\" in $keuze)].id;\n  $factor := \"${eenheid}\" = \"mm/dag\" ? 1000 / ($sum(gebieden[id in $sel].opp_ha) * 10000) : 1;\n  $rand := stromen[(van in $sel) != (naar in $sel)];\n  $info := $merge($rand.{ id: { \"post\": post, \"teken\": (naar in $sel) ? 1 : -1 } });\n  $rij := data[t >= ${__from} and t <= ${__to} and $exists($lookup($info, id))].{\n    \"post\": $lookup($info, id).post,\n    \"q\": q * $lookup($info, id).teken * $factor\n  };\n  /* dagwaarden optellen: m3/dag -> m3, of mm/dag -> mm */\n  $vol := $rij{ post & \"\": $sum(q) };\n  $posten := $each($vol, function($v, $k) { { \"post\": $k, \"volume\": $round($v, 1) } });\n  $totaal := $sum($posten.volume);\n  $append(\n    $sort($posten, function($a, $b) { $a.volume < $b.volume }),\n    [{ \"post\": \"Netto (bergingsverandering)\", \"volume\": $round($totaal, 1) }]\n  )\n)",
