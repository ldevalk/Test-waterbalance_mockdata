      "options": {
        "mode": "markdown",
        "content": "**MOCK-UP · fictieve, indicatieve data (deelgebieden en debieten zijn nog niet de echte).** Kies het hele Grenspark, één land of losse deelgebieden. Elke stroom heeft een *van* en een *naar*; hij telt mee als precies één kant binnen je selectie ligt (**+** instroom, **−** uitstroom). Uitwisseling tussen twee geselecteerde deelgebieden valt weg (zie de tabel rechtsonder). Kies **mm/dag** om gebieden van verschillende grootte te vergelijken."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Waterbalans Kalmthoutse Heide – ${gebied:text} [${eenheid}]",
      "description": "Positief = instroom in de selectie, negatief = uitstroom. Stromen tussen twee geselecteerde gebieden vallen weg. Grijze band = verwachting. Netto = bergingsverandering.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${ds}"
          },
          "type": "json",
          "source": "url",
          "url": "${data_url}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "parser": "backend",
          "root_selector": "(\n  /* Selectie: losse deelgebieden, een land (\"België\"/\"Nederland\") of \"Hele Grenspark\" */\n  $keuze := [${gebied:doublequote}];\n  $sel := gebieden[(id in $keuze) or (land in $keuze) or (\"Hele Grenspark\" in $keuze)].id;\n\n  /* Eenheid: m3/dag, of mm/dag over het oppervlak van de selectie */\n  $factor := \"${eenheid}\" = \"mm/dag\" ? 1000 / ($sum(gebieden[id in $sel].opp_ha) * 10000) : 1;\n\n  /* Randstromen: precies één kant ligt binnen de selectie. Stromen tussen twee geselecteerde gebieden vallen weg. */\n  $rand := stromen[(van in $sel) != (naar in $sel)];\n\n  /* Teken: +1 als het water de selectie in stroomt, -1 als het eruit gaat */\n  $info := $merge($rand.{ id: { \"post\": post, \"volgorde\": volgorde, \"teken\": (naar in $sel) ? 1 : -1 } });\n\n  $rij := data[t >= ${__from} and t <= ${__to} and $exists($lookup($info, id))].{\n    \"tijd\": t,\n    \"post\": $lookup($info, id).post & \"|\" & $string($lookup($info, id).volgorde),\n    \"q\": q * $lookup($info, id).teken * $factor\n  };\n\n  /* Optellen per post per dag (bv. neerslag van alle geselecteerde gebieden) + netto */\n  $posten := $rij{ post & \"|\" & $string(tijd): $sum(q) };\n  $netto  := $rij{ $string(tijd): $sum(q) };\n\n  /* Vaste volgorde: Infinity (Go) geeft gegroepeerde resultaten in willekeurige volgorde terug */\n  $uit := $append(\n    $each($posten, function($v, $k) { (\n      $d := $split($k, \"|\");\n      { \"post\": $d[0], \"volgorde\": $number($d[1]), \"tijd\": $number($d[2]), \"q\": $round($v, 3) }\n    ) }),\n    $each($netto, function($v, $k) { { \"post\": \"Netto (bergingsverandering)\", \"volgorde\": 999, \"tijd\": $number($k), \"q\": $round($v, 3) } })\n  );\n  $sort($uit, function($a, $b) { $a.volgorde > $b.volgorde or ($a.volgorde = $b.volgorde and $a.tijd > $b.tijd) })\n)",
          "columns": [
            {
              "selector": "tijd",
              "text": "tijd",
              "type": "timestamp_epoch"
            },
            {
              "selector": "post",
              "text": "post",
              "type": "string"
            },
            {
              "selector": "q",
              "text": "q",
              "type": "number"
            }
          ],
          "filters": [],
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "post"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.post}",
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
